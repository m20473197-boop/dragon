# Copy this file to ".env" and fill in your own values.
# NEVER commit the real .env — it is ignored by .gitignore on purpose.

# --- Required ---------------------------------------------------------------
# Your bot token from @BotFather.
DRAGON_BOT_TOKEN=8783123313:AAFlIw6DO4NzRD_Ul82o3O5DVIfiQ4sKHfw

# --- Optional ---------------------------------------------------------------
# Custom location for the SQLite database file.
# DRAGON_DB_PATH=/absolute/path/to/dragon.db

# --- Admin panel ------------------------------------------------------------

DRAGON_ADMIN_IDS=8154313073

# Debug/testing tools (test egg/dragon/food, hatch-time override, data reset).
# Set to false in production to hide and disable them (monitoring stays on).
# DRAGON_DEBUG=true

# --- Timing overrides (seconds) ---------------------------------------------
# Minimum time between two eggs in the same group (production 7200).
# DRAGON_EGG_SPAWN_INTERVAL=7200
# Unopened chest / uncollected egg lifetime before the message is deleted.
# DRAGON_CHEST_EXPIRE_TIME=1800
# DRAGON_EGG_EXPIRE_TIME=1800
# How long a successful open/collect message stays before being deleted.
# DRAGON_MESSAGE_DELETE_TIME=300
